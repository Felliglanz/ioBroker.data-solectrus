{
  "name": "iobroker.data-solectrus",
  "version": "0.5.0",
  "description": "ioBroker adapter to compute/mirror PV & consumption values for SOLECTRUS dashboards",
  "author": "Sven",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Felliglanz/ioBroker.data-solectrus.git"
  },
  "bugs": {
    "url": "https://github.com/Felliglanz/ioBroker.data-solectrus/issues"
  },
  "homepage": "https://github.com/Felliglanz/ioBroker.data-solectrus",
  "keywords": [
    "iobroker",
    "adapter",
    "solectrus",
    "pv",
    "formula"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.2.3",
    "jsep": "^1.3.8"
  },
  "scripts": {
